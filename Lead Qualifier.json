    {
      "parameters": {
        "jsCode": "// Get input values\nlet budget = $input.first().json['what is your budget?'];\nlet urgency = $input.first().json['How urgent it is needed?'];\n\n// Normalize urgency\nurgency = String(urgency).toLowerCase().trim();\n\n// Default fallback\nif (!budget || isNaN(budget)) {\n  return [{ json: { lead_type: \"warm\" } }];\n}\n\nif (![\"high\", \"medium\", \"low\"].includes(urgency)) {\n  urgency = \"medium\";\n}\n\n// Step 1: Base category\nlet lead = \"\";\n\nif (budget > 20000) {\n  lead = \"hot\";\n} else if (budget >= 10000) {\n  lead = \"warm\";\n} else {\n  lead = \"cold\";\n}\n\n// Step 2: Adjust using urgency\nif (urgency === \"high\") {\n  if (lead === \"cold\") lead = \"warm\";\n  else if (lead === \"warm\") lead = \"hot\";\n}\nelse if (urgency === \"low\") {\n  if (lead === \"hot\") lead = \"warm\";\n  else if (lead === \"warm\") lead = \"cold\";\n}\n\n// Return result\nreturn [\n  {\n    json: {\n      lead_type: lead,\n      Budget: budget,\n      Urgency: urgency\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
