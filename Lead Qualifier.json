      "parameters": {
        "promptType": "define",
        "text": "=Analyze:\n\nBudget: {{ $json.Budget }}\nUrgency: {{ $json.Urgency }}\n\nStep 1: Base category by budget:\n- Budget > 20000 → hot\n- Budget >= 10000 AND <= 20000 → warm\n- Budget < 10000 → cold\n\nStep 2: Adjust using urgency:\n- If urgency = high:\n    cold → warm\n    warm → hot\n    hot → hot (no change)\n\n- If urgency = low:\n    hot → warm\n    warm → cold\n    cold → cold (no change)\n\n- If urgency = medium:\n    no change\n\nFinal Output Rules:\n- Return ONLY one word: hot OR warm OR cold\n- Do NOT add any explanation or extra text\n- Output must be lowercase",
        "options": {}
      },
